# Host ports (change to e.g. 3010/3011 if running alongside wechat-selkies)
HTTP_PORT=3000
HTTPS_PORT=3001

# Container hostname; leave empty to use Docker's automatically generated hostname
WECOM_HOSTNAME=

# Desktop session user/group IDs
# PUID=1000
# PGID=100

# Selkies Web UI authentication
CUSTOM_USER=abc
# Set a strong password for web access
PASSWORD=
# TITLE=WeCom-Selkies

# Desktop & WeCom options
# TZ=Asia/Shanghai
# LC_ALL=zh_CN.UTF-8
# AUTO_START_WECOM=true
# Optional Wine DPI override (e.g., 96, 120, 144). Leave empty for default.
# WECOM_DPI=

# Build options
# INSTALL_PCMANFM=true

# Shared memory (2gb recommended for Deepin-Wine + WeCom 5.x)
SHM_SIZE=2gb

# Optional nightly stop/restart schedule
# ENABLE_WECOM_NIGHTLY_RESTART=false
# WECOM_NIGHTLY_STOP_TIME=23:30
# WECOM_NIGHTLY_START_TIME=01:30
